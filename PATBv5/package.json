{
  "name": "polymarket-trade-bot-ts-v5",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Polymarket trading bot v5 scaffold for guarded real-money trading research",
  "main": "index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:ui": "node -e \"process.env.UI_SERVER_ENABLED='1'; require('./dist/index.js')\"",
    "ui:install": "npm install --prefix newGui",
    "ui:dev": "npm run dev --prefix newGui",
    "ui:build": "npm run build --prefix newGui",
    "builder-auth:check": "tsx scripts/check_builder_auth.ts",
    "deposit-wallet:check": "tsx scripts/deploy_deposit_wallet.ts",
    "deposit-wallet:deploy": "tsx scripts/deploy_deposit_wallet.ts --deploy",
    "analyze:trades": "tsx scripts/analyze_trades.ts",
    "validate:signals": "tsx scripts/validate_signal_modules.ts",
    "check:live-readiness": "tsx scripts/live_readiness.ts",
    "feed:readiness": "tsx scripts/check_feed_readiness.ts",
    "cohort:fresh": "tsx scripts/build_fresh_cohort.ts",
    "test:all": "npm run test:telemetry && npm run test:isolated-runner && npm run test:lifecycle && npm run test:entry-ratio && npm run test:entry-timing && npm run test:execution-pricing && npm run test:shadow-settlement && npm run test:gamma-http && npm run test:report-shadow-pnl && npm run test:report-tabs && npm run test:report-actions && npm run test:report-accuracy && npm run test:report-control && npm run test:feedgate && npm run test:montecarlo && npm run test:momentum && npm run test:feed-fallback && npm run test:feed-partial-book && npm run test:feed-reconnect && npm run test:feed-freshness && npm run test:rejection-payload && npm run test:report-rejection-payloads",
    "test:telemetry": "tsx scripts/run_isolated_test.ts tests/telemetry_rotation.test.ts",
    "test:isolated-runner": "tsx scripts/run_isolated_test.ts tests/isolated_test_runner.test.ts",
    "test:lifecycle": "tsx scripts/run_isolated_test.ts scripts/check3_lifecycle_harness.ts",
    "test:entry-ratio": "tsx scripts/run_isolated_test.ts tests/entry_ratio.test.ts",
    "test:entry-timing": "tsx scripts/run_isolated_test.ts tests/entry_timing.test.ts",
    "test:execution-pricing": "tsx scripts/run_isolated_test.ts tests/execution_pricing.test.ts",
    "test:shadow-settlement": "tsx scripts/run_isolated_test.ts tests/shadow_settlement.test.ts",
    "test:shadow-settlement-queue": "tsx scripts/run_isolated_test.ts tests/shadow_settlement_queue.test.ts",
    "test:gamma-http": "tsx scripts/run_isolated_test.ts tests/gamma_http.test.ts",
    "test:report-shadow-pnl": "tsx scripts/run_isolated_test.ts tests/report_shadow_pnl.test.ts",
    "test:report-tabs": "tsx tests/report_static_tabs.test.ts",
    "test:report-actions": "tsx tests/report_actions.test.ts",
    "test:report-accuracy": "tsx tests/report_accuracy.test.ts",
    "test:report-control": "tsx tests/report_control.test.ts",
    "test:feedgate": "tsx scripts/run_isolated_test.ts tests/feedgate.test.ts",
    "test:feed-transport-error": "tsx scripts/run_isolated_test.ts tests/feed_transport_error.test.ts",
    "test:feed-readiness": "tsx scripts/run_isolated_test.ts tests/feed_readiness.test.ts",
    "test:montecarlo": "tsx scripts/run_isolated_test.ts tests/montecarlo.test.ts",
    "test:momentum": "tsx scripts/run_isolated_test.ts tests/momentum.test.ts",
    "test:feed-fallback": "tsx scripts/run_isolated_test.ts tests/marketFeed.fallbackBehavior.test.ts",
    "test:feed-partial-book": "tsx scripts/run_isolated_test.ts tests/marketFeed.partialBookUpdates.test.ts",
    "test:feed-reconnect": "tsx scripts/run_isolated_test.ts tests/marketFeed.reconnectPolicy.test.ts",
    "test:feed-freshness": "tsx scripts/run_isolated_test.ts tests/marketFeed.snapshotFreshness.test.ts",
    "test:rejection-payload": "tsx scripts/run_isolated_test.ts tests/rejection_payload_context.test.ts",
    "test:report-rejection-payloads": "tsx scripts/run_isolated_test.ts tests/report_rejection_payloads.test.ts",
    "polymarket-api-creds:refresh": "python scripts/derive_polymarket_api_creds.py --store",
    "test": "npm run test:all",
    "report": "tsx src/report/index.ts",
    "report:serve": "tsx src/report/index.ts --serve"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@polymarket/builder-relayer-client": "^0.0.9",
    "@polymarket/builder-signing-sdk": "^0.0.8",
    "@polymarket/clob-client-v2": "^1.0.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/ws": "^8.18.1",
    "ccxt": "^4.5.36",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "viem": "^2.48.8",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
