PAPER_TRADING=true
PAPER_STARTING_USD=100
# MetaMask Polymarket.com account: use signature type 2 and the proxy wallet shown in Polymarket.
# Standalone MetaMask EOA: use signature type 0 and set PROXY_WALLET_ADDRESS to the EOA address.
POLYMARKET_SIGNATURE_TYPE=2
RABBITHAT_SECRET_COMMAND=
RABBITHAT_SECRET_PREFIX=
RABBITHAT_ALLOW_DOTENV_SECRETS=false
# Set to true only for short-lived local debugging when secrets live in .env.
PROXY_WALLET_ADDRESS=your_metamask_polymarket_proxy_wallet_address_here
COLLATERAL_GUARD_ENABLED=true
COLLATERAL_GUARD_POLL_MS=2500
COLLATERAL_GUARD_CONFIRMATION_BLOCKS=3
COLLATERAL_GUARD_MAX_BLOCK_RANGE=2
# Extra comma-separated recipient addresses to permit. Leave empty unless you intentionally withdraw/route funds.
COLLATERAL_GUARD_ALLOWED_RECIPIENTS=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
NODE_EXE=C:\Program Files\nodejs\node.exe
